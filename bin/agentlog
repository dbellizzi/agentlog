$APP_JS = <<'JS';
'use strict';
// Messages kept on the page. ?max= overrides the default of 500.
const MAX = (function () {
  const v = parseInt(new URLSearchParams(location.search).get('max'), 10);
  return v > 0 ? Math.min(v, 1000) : 500;
})();
const AGENT_COLORS = { 'claude-code': '#ff8a65', codex: '#34d3b4', muse: '#b69cff', antigravity: '#6cb6ff' };
const KIND_COLORS = { claim: '#ffd166', request: '#ff6b9a', reply: '#6cb6ff', done: '#4ade80', note: '#c9d1d9', release: '#ffb86b' };
const FALLBACK = '#c9d1d9';
const ARROW = '\u2192';
const CLOCK = '\u23f1';
const MIDDOT = '\u00b7';
const COPY_ICON = '\u29c9';
const CHECK = '\u2713';
const pageStart = Date.now();

const own = (o, k) => Object.prototype.hasOwnProperty.call(o, k);
const agentColor = (a) => (own(AGENT_COLORS, a) ? AGENT_COLORS[a] : FALLBACK);
const kindColor = (k) => (own(KIND_COLORS, k) ? KIND_COLORS[k] : FALLBACK);
const session8 = (s) => String(s || '').slice(0, 8);
const shortId = (id) => String(id || '').slice(-6);
const parse = (s) => { try { return JSON.parse(s); } catch (_) { return null; } };

function alpha(hex, a) {
  const n = parseInt(hex.slice(1), 16);
  return 'rgba(' + ((n >> 16) & 255) + ',' + ((n >> 8) & 255) + ',' + (n & 255) + ',' + a + ')';
}
function el(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text != null) e.textContent = text;
  return e;
}
function cell(text, cls) {
  return el('td', cls || null, text == null ? '' : String(text));
}
function emptyRow(cols, text) {
  const tr = el('tr', null, null);
  const td = el('td', 'empty', text);
  td.colSpan = cols;
  tr.appendChild(td);
  return tr;
}
function timeLeft(expires) {
  if (expires == null) return 'no expiry';
  const mins = Math.floor((expires * 1000 - Date.now()) / 60000);
  return mins > 0 ? mins + 'm left' : 'expired';
}
function avatar(color) {
  const NS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(NS, 'svg');
  svg.setAttribute('class', 'avatar');
  svg.setAttribute('viewBox', '0 0 40 44');
  svg.setAttribute('width', '40');
  svg.setAttribute('height', '44');
  svg.setAttribute('aria-hidden', 'true');
  svg.style.color = color;
  const use = document.createElementNS(NS, 'use');
  use.setAttribute('href', '#bot');
  // The symbol's own viewBox does the offset, as in the hero.
  use.setAttribute('x', '0');
  use.setAttribute('y', '0');
  use.setAttribute('width', '40');
  use.setAttribute('height', '44');
  svg.appendChild(use);
  return svg;
}

// Copy an id. The button shows a check for 1.2s. If the clipboard is refused,
// the id is selected in a hidden read-only input so the user can press Ctrl/Cmd+C.
let fallbackInput = null;
function selectForCopy(text) {
  if (!fallbackInput) {
    fallbackInput = el('input', null, null);
    fallbackInput.type = 'text';
    fallbackInput.readOnly = true;
    fallbackInput.tabIndex = -1;
    fallbackInput.setAttribute('aria-hidden', 'true');
    fallbackInput.style.cssText = 'position:fixed;left:0;top:0;width:1px;height:1px;opacity:0;';
    document.body.appendChild(fallbackInput);
  }
  fallbackInput.value = text;
  fallbackInput.focus();
  fallbackInput.select();
}
// Ids whose copy button shows the check mark, id -> timer. A table re-render
// rebuilds the buttons, so the state lives here and every button for an id follows it.
const flashing = new Map();
function paintCopy(id) {
  const on = flashing.has(id);
  document.querySelectorAll('button.copy').forEach((b) => {
    if (b.title !== id) return;
    b.textContent = on ? CHECK : COPY_ICON;
    b.classList.toggle('copied', on);
  });
}
function copyButton(id, label) {
  const btn = el('button', 'copy', flashing.has(id) ? CHECK : COPY_ICON);
  if (flashing.has(id)) btn.classList.add('copied');
  btn.type = 'button';
  btn.setAttribute('aria-label', label);
  btn.title = id;
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const flash = () => {
      clearTimeout(flashing.get(id));
      flashing.set(id, setTimeout(() => { flashing.delete(id); paintCopy(id); }, 1200));
      paintCopy(id);
    };
    const fail = () => selectForCopy(id);
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(id).then(flash, fail);
    } else {
      fail();
    }
  });
  return btn;
}

// Owner: agent in its colour, then :session8 muted, all on one line.
function ownerCell(agent, session, stale) {
  const td = el('td', null, null);
  td.title = (agent || '?') + ':' + (session || '');
  const line = el('span', 'own-line', null);
  const dotEl = el('span', 'agent-dot', null);
  dotEl.style.background = agentColor(agent);
  const sub = el('span', 'own-sub', session8(session));
  line.append(dotEl, sub);
  if (stale) line.appendChild(el('span', 'tag', 'stale'));
  td.appendChild(line);
  return td;
}
// One line with an ellipsis; the full value goes in the title.
function ellCell(text) {
  const s = text == null ? '' : String(text);
  const td = el('td', null, null);
  td.title = s;
  td.appendChild(el('span', 'cell-ell', s));
  return td;
}
// First path, then a muted +N when there are more. The title holds the full list.
function pathsCell(paths) {
  const list = String(paths || '').split(/[ ,]+/).filter(Boolean);
  const td = el('td', null, null);
  td.title = list.join(' ');
  const line = el('span', 'cell-ell', list[0] || '');
  if (list.length > 1) line.appendChild(el('span', 'more', '+' + (list.length - 1)));
  td.appendChild(line);
  return td;
}

const list = document.getElementById('messages');
const scroller = document.getElementById('scroll');
const seenIds = new Set();
let claims = [];
let sessions = [];

function updateCounts() {
  const agents = new Set(sessions.map((s) => s.agent)).size;
  document.getElementById('pill').textContent =
    agents + (agents === 1 ? ' agent' : ' agents') + ' ' + MIDDOT + ' 1 board';
  document.getElementById('counts').textContent =
    claims.length + ' active claims ' + MIDDOT + ' ' + sessions.length + ' sessions (24h) ' + MIDDOT + ' ' +
    list.children.length + ' messages';
}

function renderClaims() {
  const body = document.querySelector('#claims tbody');
  body.replaceChildren();
  if (!claims.length) body.appendChild(emptyRow(6, 'no active claims'));
  for (const c of claims) {
    const row = el('tr', null, null);
    row.title = c.id || '';
    const copy = el('td', 'copy-cell', null);
    copy.appendChild(copyButton(c.id || '', 'Copy claim ID'));
    row.append(
      ownerCell(c.agent, c.session, false),
      ellCell(c.branch),
      pathsCell(c.paths),
      ellCell(String(c.body || '').split('\n')[0]),
      ellCell(timeLeft(c.expires)),
      copy);
    body.appendChild(row);
  }
  updateCounts();
}

function renderSessions() {
  const body = document.querySelector('#sessions tbody');
  body.replaceChildren();
  if (!sessions.length) body.appendChild(emptyRow(4, 'no sessions'));
  for (const s of sessions) {
    const row = el('tr', s.stale ? 'stale' : null, null);
    row.append(
      ownerCell(s.agent, s.session, !!s.stale),
      ellCell(s.branch),
      ellCell(s.worktree),
      ellCell(s.seen));
    body.appendChild(row);
  }
  updateCounts();
}

// "+ show all" appears only while the paths are clamped to two lines. The clamp
// depends on the width, so refreshClamps runs again after a resize.
function clampToggle(li) {
  const pathsEl = li.querySelector('.paths-clamp');
  if (!pathsEl) return;
  const next = pathsEl.nextElementSibling;
  const existing = next && next.classList.contains('show-all') ? next : null;
  const clamped = pathsEl.classList.contains('open') || pathsEl.scrollHeight > pathsEl.clientHeight;
  if (clamped && !existing) {
    const toggle = el('button', 'show-all', '+ show all');
    toggle.type = 'button';
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = pathsEl.classList.toggle('open');
      toggle.textContent = open ? 'show less' : '+ show all';
    });
    pathsEl.after(toggle);
  } else if (!clamped && existing) {
    existing.remove();
    pathsEl.classList.remove('open');
  }
}
function refreshClamps() {
  for (const li of list.children) clampToggle(li);
}
let resizeTimer = null;
window.addEventListener('resize', () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(refreshClamps, 150);
});

function addMessage(m) {
  if (m.id && seenIds.has(m.id)) return;   // replayed after a reconnect
  const agent = m.agent || 'unknown';
  const color = agentColor(agent);
  const kind = m.kind || '?';
  const li = el('li', 'msg', null);
  // Live means it was written after this page loaded; backlog never glows.
  if (Date.parse(m.date) >= pageStart - 2000) li.classList.add('live');
  if (m.id) li.dataset.id = m.id;
  li.style.borderColor = alpha(color, 0.35);
  if (kind === 'request') li.style.borderLeft = '3px solid ' + KIND_COLORS.request;

  const glow = el('span', 'glow', null);
  glow.style.background = alpha(color, 0.08);
  glow.style.borderColor = color;
  li.append(glow, avatar(color));

  const content = el('div', 'content', null);
  // Row 1: agent:session8 @branch kind -> to
  const row1 = el('div', 'row1', null);
  const who = el('span', 'who', agent);
  who.style.color = color;
  row1.append(who, el('span', null, ':' + session8(m.session)));
  if (m.branch && m.branch !== '-') {
    const br = el('span', 'branch', '@' + m.branch);
    br.title = m.branch;
    row1.appendChild(br);
  }
  const kindEl = el('span', 'kind', kind);
  kindEl.style.color = kindColor(kind);
  row1.appendChild(kindEl);
  if (m.to && m.to !== '*') row1.appendChild(el('span', null, ARROW + ' ' + m.to));
  content.appendChild(row1);
  // Row 2: paths, time left, re= (wraps)
  const row2Items = [];
  if (m.paths) {
    const pathsEl = el('span', 'paths-clamp', m.paths);
    pathsEl.title = m.paths;
    row2Items.push(pathsEl);
  }
  if (kind === 'claim' && m.expires != null) row2Items.push(el('span', null, CLOCK + ' ' + timeLeft(m.expires)));
  if (m.re) row2Items.push(el('span', null, 're=' + m.re));
  if (row2Items.length) {
    const row2 = el('div', 'row2', null);
    row2.append(...row2Items);
    content.appendChild(row2);
  }
  // Row 3: date and the last 6 characters of the id, with a copy button
  const row3 = el('div', 'row3', null);
  row3.appendChild(el('span', 'r3t', (m.date || '') + '  ' + shortId(m.id)));
  if (m.id) row3.appendChild(copyButton(m.id, 'Copy message ID'));
  content.appendChild(row3);
  content.appendChild(el('div', 'text', m.body == null ? '' : m.body));
  li.appendChild(content);

  const scrolled = scroller.scrollTop > 0;
  list.prepend(li);
  clampToggle(li);
  if (scrolled) scroller.scrollTop += li.offsetHeight;
  if (m.id) seenIds.add(m.id);
  while (list.children.length > MAX) {
    const old = list.lastElementChild;
    if (old.dataset.id) seenIds.delete(old.dataset.id);
    old.remove();
  }
  updateCounts();
}

const dot = document.getElementById('dot');
const es = new EventSource('/events?n=' + MAX);
es.onopen = () => { dot.className = 'dot on'; };
es.onerror = () => { dot.className = 'dot off'; };
es.addEventListener('store', (e) => {
  const s = parse(e.data);
  if (typeof s === 'string') document.getElementById('store').textContent = s;
});
es.addEventListener('msg', (e) => { const m = parse(e.data); if (m) addMessage(m); });
es.addEventListener('claims', (e) => {
  const next = parse(e.data) || [];
  if (JSON.stringify(next) === JSON.stringify(claims)) return;   // unchanged: keep the rows and their state
  claims = next;
  renderClaims();
});
es.addEventListener('sessions', (e) => { sessions = parse(e.data) || []; renderSessions(); });
setInterval(renderClaims, 30000);
updateCounts();
JS

while (1) {
    my @rh = ($listen, \*STDIN);
    push @rh, $_->{sock} for values %clients;
    my @wh = map { $_->{sock} } grep { length $_->{out} } values %clients;
    my ($rr, $ww) = IO::Select->select(IO::Select->new(@rh), IO::Select->new(@wh), undef, 1);
    for my $h (@{ $rr || [] }) {
        if ($h == $listen) { accept_client(); next }
        my $fd = fileno($h);
        next unless defined $fd;
        if ($fd == 0) { read_stdin(); next }
        my $c = $clients{$fd} or next;
        read_client($c);
    }
    for my $h (@{ $ww || [] }) {
        my $fd = fileno($h);
        my $c = defined $fd && $clients{$fd} or next;
        flush_client($c);
    }
    for my $c (values %clients) { drop($c) if $c->{closing} && !length $c->{out} }
    if (time - $last_ping >= 15) {
        broadcast_sse(": ping\n\n");
        $last_ping = time;
    }
}
PERL
}

# ---------------------------------------------------------------- main

[ $# -gt 0 ] || { usage; exit 1; }
cmd=$1; shift
case $cmd in
  hook) cmd_hook "$@"; exit ;;
  install) cmd_install "$@"; exit ;;
  -h | --help | help) usage; exit 0 ;;
  --version | version) echo "agentlog $VERSION"; exit 0 ;;
esac
detect_identity
case $cmd in
  write | w) cmd_write "$@" ;;
  read | r) cmd_read "$@" ;;
  tail) cmd_tail "$@" ;;
  claims) cmd_claims ;;
  who) cmd_who ;;
  show) cmd_show "$@" ;;
  whoami) printf '%s:%s (session %s)\n' "$AGENT" "$SHORT" "$SESSION" ;;
  gc) cmd_gc "$@" ;;
  sync) cmd_sync "$@" ;;
  dashboard) cmd_dashboard "$@" ;;
  dir)
    ensure_store
    printf '%s\n' "$STORE"
    if [ -z "$W" ]; then printf '(read-only here: nothing writable)\n'
    elif [ "$W" != "$STORE" ]; then printf '(shared store not writable here; writing to %s)\n' "$W"; fi
    if [ -n "$(remote_url)" ]; then
      if ! _k=$(repo_key); then printf '(not synced: no usable origin remote)\n'
      elif ! repo_synced "$_k"; then printf '(not synced: %s is not in sync_repos)\n' "$_k"
      else printf 'synced with %s/%s\n' "$(remote_url)" "$_k"; fi
    fi
    ;;
  *) usage >&2; exit 1 ;;
esac
