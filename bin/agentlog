#!/bin/sh
# shellcheck disable=SC2016 # single-quoted awk/sed programs are intentional
# agentlog — a shared, append-only message board for coding agents working in
# the same repository. One file per message, written to tmp/ and renamed into
# msgs/, so concurrent writers never interleave and no locking is needed.
# See docs/protocol.md for the protocol.
set -eu

# Codex's allow rule (see `agentlog install`) runs this script outside the
# sandbox, so never trust the caller's environment: keep only what agentlog
# reads and pin PATH to system locations.
_keep=" PATH HOME USER LOGNAME TMPDIR LANG LC_ALL LC_CTYPE TERM AGENTLOG_SESSION AGENTLOG_AGENT \
AGENTLOG_DIR AGENTLOG_PREFIX AGENTLOG_NO_INSTALL CODEX_HOME CLAUDE_CODE_SESSION_ID CODEX_SESSION_ID \
CODEX_THREAD_ID OPENCODE_SESSION_ID CURSOR_SESSION_ID MUSE_SESSION_ID MUSE_THREAD_ID \
ANTIGRAVITY_CONVERSATION_ID SSH_AUTH_SOCK AGENTLOG_REMOTE "
for _v in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
  case $_keep in *" $_v "*) ;; *) unset "$_v" 2>/dev/null || : ;; esac
done
PATH=/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin
export PATH
unset _v _keep

VERSION=0.7.0
# Resolve our own path now: hooks may cd into the workspace later, which
# would break a relative $0 such as Antigravity's ./bin/agentlog.
SELF=$(cd "$(dirname "$0")" && pwd -P)/$(basename "$0")
KINDS="note claim release request reply done"

die() { printf 'agentlog: %s\n' "$*" >&2; exit 1; }
need() { [ $# -ge 2 ] || die "option $1 needs a value"; }

# ---------------------------------------------------------------- store

# The shared store lives next to the main worktree's .git (not inside it —
# Codex's sandbox mounts .git read-only), so every worktree of a repo shares it.
#
# Sandboxed agents in a linked worktree often cannot write outside that
# worktree. They write to a local store at <worktree>/.agentlog instead
# (covered by the same /.agentlog/ exclude), readers union every store, and
# any unsandboxed run (hooks usually are) migrates local messages into the
# shared store.
resolve_store() {
  LOCAL=''
  if [ -n "${AGENTLOG_DIR:-}" ]; then STORE=$AGENTLOG_DIR; return; fi
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) ||
    die "not inside a git repository (set AGENTLOG_DIR to use a plain directory)"
  case $common in
    */.git) STORE=${common%/.git}/.agentlog ;;
    *) STORE=$common/agentlog ;; # bare repo
  esac
  LOCAL=$(worktree)/.agentlog
  [ "$LOCAL" = "$STORE" ] && LOCAL=''
  exclude=$common/info/exclude
  if ! grep -qsx '/.agentlog/' "$exclude" 2>/dev/null; then
    { mkdir -p "$common/info" && printf '/.agentlog/\n' >>"$exclude"; } 2>/dev/null || :
  fi
}

# Create (or check) a store and prove it is writable. The .agentlog-store
# marker is what gc and migration require before deleting anything, so a
# hostile AGENTLOG_DIR or worktree path cannot aim them at unrelated files.
mkstore() {
  mkdir -p "$1/msgs" "$1/tmp" "$1/seen" "$1/sessions" 2>/dev/null &&
    (: >"$1/tmp/.probe.$$") 2>/dev/null && rm -f "$1/tmp/.probe.$$" &&
    { [ -f "$1/.agentlog-store" ] || : >"$1/.agentlog-store"; }
}
is_store() { [ -f "$1/.agentlog-store" ]; }

# Sets W, the store this process writes to, or "" when nothing is writable
# (a read-only sandbox): reads still work but do not advance the cursor.
# TMP holds scratch files and is always writable.
ensure_store() {
  resolve_store
  W=''
  TMP=$(mktemp -d "${TMPDIR:-/tmp}/agentlog.XXXXXX")
  trap 'rm -rf "$TMP"' 0
  if mkstore "$STORE"; then
    W=$STORE
    migrate_local
  elif [ -n "$LOCAL" ] && mkstore "$LOCAL"; then
    W=$LOCAL
  fi
}

need_writable() { [ -n "$W" ] || die "cannot write to $STORE${LOCAL:+ or $LOCAL}"; }

# Every store that may hold messages: the shared one, then each worktree's.
stores() {
  printf '%s\n' "$STORE"
  [ -n "${AGENTLOG_DIR:-}" ] && return
  git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' |
    while IFS= read -r wt; do
      is_store "$wt/.agentlog" && [ "$wt/.agentlog" != "$STORE" ] && printf '%s\n' "$wt/.agentlog"
    done
  return 0
}

# Move messages, read cursors and presence from worktree stores into the
# shared one. Copy-then-rename keeps each message atomic even across
# filesystems; a message briefly in both places is deduplicated by id.
migrate_local() {
  stores | sed 1d | while IFS= read -r ls; do
    for f in "$ls"/msgs/*.msg; do
      [ -f "$f" ] || continue
      _t=$STORE/msgs/.w.$$.$(rand)
      cp "$f" "$_t" && mv -f "$_t" "$STORE/msgs/${f##*/}" && rm -f "$f"
    done
    for f in "$ls"/seen/*; do
      [ -f "$f" ] || continue
      _d=$STORE/seen/${f##*/}
      # Keep the older cursor mtime: the hook's fast path skips messages
      # older than the cursor, so a merge must never move it forward.
      if [ -f "$_d" ] && newer "$f" "$_d"; then touch -r "$_d" "$TMP/ref"; else touch -r "$f" "$TMP/ref"; fi
      touch "$_d"
      sort -u "$_d" "$f" | atomic_write "$_d" && touch -r "$TMP/ref" "$_d" && rm -f "$f"
    done
    for f in "$ls"/sessions/*; do
      [ -f "$f" ] || continue
      _d=$STORE/sessions/${f##*/}
      if [ ! -f "$_d" ] || newer "$f" "$_d"; then atomic_write "$_d" <"$f"; fi
      rm -f "$f"
    done
  done
}

# Atomic replace: write a hidden temp file beside $1, then rename over it.
atomic_write() {
  _t=$(dirname "$1")/.w.$$.$(rand)
  cat >"$_t"
  mv -f "$_t" "$1"
}

rand() { od -An -N3 -tx1 /dev/urandom | tr -d ' \n'; }
now_epoch() { date -u +%s; }

# Sortable UTC timestamp with microseconds, so names order like writes do.
# GNU date and newer macOS date have %N; older BSD date does not, so fall back
# to perl (ships with macOS). One date call, so the seconds and the fraction
# come from the same instant (two calls can straddle a second boundary).
stamp() {
  _s=$(date -u '+%Y%m%dT%H%M%S.%N' 2>/dev/null)
  case ${_s#*.} in
    [0-9][0-9][0-9][0-9][0-9][0-9]*) printf '%s.%.6sZ\n' "${_s%.*}" "${_s#*.}" ;;
    *) perl -MTime::HiRes=time -MPOSIX=strftime -e \
      '$t = time; printf "%s.%06dZ", strftime("%Y%m%dT%H%M%S", gmtime $t), ($t - int $t) * 1e6' ;;
  esac
}
# POSIX test(1) has no -nt/-ot; ask find instead. newer A B: A modified after B.
newer() { [ -n "$(find "$1" -prune -newer "$2" 2>/dev/null)" ]; }
oneline() { printf '%s' "$1" | tr '\t\r\n' '   '; }

# ---------------------------------------------------------------- identity

# AGENTLOG_SESSION/AGENTLOG_AGENT win; otherwise each agent's own session env.
detect_identity() {
  AGENT=${AGENTLOG_AGENT:-}
  SESSION=${AGENTLOG_SESSION:-}
  if [ -z "$SESSION" ]; then
    # An agent started from another agent's shell inherits that agent's
    # session variable too, and Claude Code's leaks into everything it runs.
    # So check the agents least likely to be the outer host first.
    if [ -n "${ANTIGRAVITY_CONVERSATION_ID:-}" ]; then
      SESSION=$ANTIGRAVITY_CONVERSATION_ID; : "${AGENT:=antigravity}"
    elif [ -n "${MUSE_SESSION_ID:-}" ]; then
      SESSION=$MUSE_SESSION_ID; : "${AGENT:=muse}"
    elif [ -n "${CODEX_SESSION_ID:-}${CODEX_THREAD_ID:-}" ]; then
      SESSION=${CODEX_SESSION_ID:-$CODEX_THREAD_ID}; : "${AGENT:=codex}"
    elif [ -n "${OPENCODE_SESSION_ID:-}" ]; then
      SESSION=$OPENCODE_SESSION_ID; : "${AGENT:=opencode}"
    elif [ -n "${CURSOR_SESSION_ID:-}" ]; then
      SESSION=$CURSOR_SESSION_ID; : "${AGENT:=cursor}"
    elif [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
      SESSION=$CLAUDE_CODE_SESSION_ID; : "${AGENT:=claude-code}"
    else
      SESSION=anon-$PPID
    fi
  fi
  : "${AGENT:=unknown}"
  SESSION=$(printf '%s' "$SESSION" | tr -cd 'A-Za-z0-9._-' | sed 's/^[.-]*//')
  AGENT=$(printf '%s' "$AGENT" | tr -cd 'A-Za-z0-9._-' | sed 's/^[.-]*//')
  [ -n "$SESSION" ] || die "empty session id"
  SHORT=$(printf '%.8s' "$SESSION")
}

worktree() { git rev-parse --show-toplevel 2>/dev/null || pwd; }
# Short machine name, shown when a message or session comes from another
# machine through a synced board. `host=` in the config file overrides it.
host() {
  _h=$(config_get host)
  [ -n "$_h" ] || _h=$(hostname -s 2>/dev/null || hostname 2>/dev/null || echo -)
  oneline "$_h" | tr -cd 'A-Za-z0-9._-'
}
branch() { git symbolic-ref --short -q HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null || echo -; }

# Presence: one file per session, rewritten on each prompt (and every few
# minutes of tool calls). via=hook marks sessions whose agent runs our hooks;
# only their claims lapse when the presence goes stale (see stale_owners).
touch_presence() {
  [ -n "$W" ] || return 0
  _via=${HOOKED:-}
  [ -z "$_via" ] && grep -qsx 'via=hook' "$W/sessions/$SESSION" "$STORE/sessions/$SESSION" && _via=1
  {
    printf 'agent=%s\nsession=%s\nbranch=%s\nworktree=%s\nhost=%s\nseen=%s\n' \
      "$AGENT" "$SESSION" "$(branch)" "$(worktree)" "$(host)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    [ -n "$_via" ] && printf 'via=hook\n'
    [ -n "${ENDED:-}" ] && printf 'ended=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } | atomic_write "$W/sessions/$SESSION"
}

# Minutes without presence after which a hooked session counts as gone.
STALE_MIN=60

# Space-separated ids of hooked sessions not seen for STALE_MIN minutes in
# any store. Their claims stop counting: the agent most likely exited without
# a SessionEnd hook (crash, closed terminal, an agent that has none).
stale_owners() {
  stores | while IFS= read -r st; do
    [ -d "$st/sessions" ] && find "$st/sessions" -maxdepth 1 -type f -mmin -"$STALE_MIN" 2>/dev/null | sed 's|.*/|fresh |'
    [ -d "$st/sessions" ] && find "$st/sessions" -maxdepth 1 -type f -mmin +"$STALE_MIN" -exec grep -lx 'via=hook' {} + 2>/dev/null | sed 's|.*/|old |'
  done | awk '$1 == "fresh" { f[$2] = 1 } $1 == "old" { o[$2] = 1 }
    END { printf " "; for (s in o) if (!(s in f)) printf "%s ", s; print "" }'
}

# ---------------------------------------------------------------- index

# One TSV line per message across all stores, sorted oldest first:
# name kind agent session to re expires paths branch date path
index() {
  stores | while IFS= read -r st; do
    [ -d "$st/msgs" ] && find "$st/msgs" -name '*.msg' -type f
  done | tr '\n' '\0' | xargs -0 awk '
    FNR == 1 { inh = 1; k = a = s = t = r = e = p = b = d = h = "" }
    inh && /^$/ {
      n = FILENAME; sub(/.*\//, "", n); sub(/\.msg$/, "", n)
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", n, k, a, s, t, r, e, p, b, d, FILENAME, h
      inh = 0; next
    }
    !inh { next }
    { key = $0; sub(/:.*/, "", key); val = $0; sub(/^[^:]*: ?/, "", val) }
    key == "Kind" { k = val } key == "Agent" { a = val } key == "Session" { s = val }
    key == "To" { t = val } key == "Re" { r = val } key == "Expires" { e = val }
    key == "Paths" { p = val } key == "Branch" { b = val } key == "Date" { d = val }
    key == "Host" { h = val }
  ' /dev/null | sort | awk -F '\t' '!seen[$1]++' # /dev/null: never read stdin
}

# Active claims (TSV, same columns). A claim ends when it expires, when its
# owner's session goes stale (stale_owners), or when its owner posts
# release/done after it:
#  - with Re: <claim id>, closing that claim;
#  - with Paths but no Re, closing that session's claims whose paths it lists;
#  - with neither, closing everything that session claimed before it.
active_claims() {
  index | awk -F '\t' -v now="$(now_epoch)" -v stale="$(stale_owners)" '
    # Every path of the claim appears in the closing message (space or comma lists).
    function covers(cp, ep,   c, e, set, i, nc, ne) {
      nc = split(cp, c, /[ ,]+/); ne = split(ep, e, /[ ,]+/)
      for (i = 1; i <= ne; i++) if (e[i] != "") set[e[i]] = 1
      for (i = 1; i <= nc; i++) if (c[i] != "" && !(c[i] in set)) return 0
      return 1
    }
    function ended_by_paths(i,   j) {
      for (j = 1; j <= n_end; j++)
        if (end_sess[j] == sess[i] && end_name[j] > name[i] && covers(paths[i], end_paths[j])) return 1
      return 0
    }
    { name[NR] = $1; sess[NR] = $4; expv[NR] = $7; paths[NR] = $8; line[NR] = $0 }
    $2 == "claim" { claim[NR] = 1 }
    ($2 == "release" || $2 == "done") && $6 != "" { closed[$6] = 1 }
    ($2 == "release" || $2 == "done") && $6 == "" {
      if ($8 == "") relall[$4] = $1
      else { n_end++; end_sess[n_end] = $4; end_name[n_end] = $1; end_paths[n_end] = $8 }
    }
    END {
      for (i = 1; i <= NR; i++) {
        if (!claim[i]) continue
        if (expv[i] != "" && expv[i] + 0 <= now) continue
        if (index(stale, " " sess[i] " ")) continue
        if (closed[name[i]]) continue
        if ((sess[i] in relall) && relall[sess[i]] > name[i]) continue
        if (ended_by_paths(i)) continue
        print line[i]
      }
    }'
}

fmt_claims() {
  awk -F '\t' -v now="$(now_epoch)" -v me="$SESSION" -v here="$(host)" '{
    left = ($7 == "") ? "no expiry" : int(($7 - now) / 60) "m left"
    who = $3 ":" substr($4, 1, 8); if ($4 == me) who = who " (you)"
    if ($12 != "" && $12 != here) who = who " on " $12
    printf "  %s  %s  [%s]  id=%s\n", who, $8, left, $1
  }'
}

# ---------------------------------------------------------------- commands

usage() {
  cat <<'EOF'
agentlog — shared message board for agents working in the same repo

  agentlog write [-k KIND] [-t TO] [-r ID] [-p PATHS] [--ttl DUR] MESSAGE...
                 MESSAGE may be "-" (or omitted) to read the body from stdin.
                 KIND: note (default; reply with -r) | claim | release | request | reply | done
                 TO:   * (default) | agent name (codex, claude-code) | session-id prefix
  agentlog read  [--peek] [--all] [-n N] [--json] [--kind K1,K2]
                 unread messages for this session (--json: JSON Lines)
                 [--from AGENT] show only that agent name or session-id prefix; marks all read
  agentlog tail [-n N] [-f]                last N messages (10); follow every 2s
  agentlog claims                          active claims (who is working on what)
  agentlog who                             sessions active in the last 24h
  agentlog show ID                         print one message in full
  agentlog whoami                          print this session's identity
  agentlog gc [--days N]                   delete messages older than N days (7)
  agentlog install [--codex-rule|--no-codex-rule] [--antigravity-rule|--no-antigravity-rule]
                 [--uninstall] [--quiet]
                 copy to ~/.local/bin; allow it in Codex (unsandboxed) and Antigravity (unprompted)
  agentlog install --remote URL | --no-remote  [--sync-repos 'GLOB ...']
                 sync boards with ssh://[user@]host/abs/path (or a directory); limit to
                 repo keys matching the globs, e.g. 'github.com/me/*' (default all)
  agentlog sync [--quiet]                  sync this repo's board now (hooks do it every 10s)
  agentlog dashboard [--port P] [-n N] [--no-open]
                 live page of the board at http://127.0.0.1:P/ (P 0 = any free port);
                 opens it in the browser when run from a terminal
  agentlog hook AGENT [EVENT]              hook entry point (reads hook JSON on stdin)
  agentlog dir                             print the store directory
EOF
}

parse_ttl() {
  case $1 in
    *[!0-9smhd]* | "") die "bad --ttl '$1' (use e.g. 30m, 2h, 1d)" ;;
    *d) echo $((${1%d} * 86400)) ;;
    *h) echo $((${1%h} * 3600)) ;;
    *m) echo $((${1%m} * 60)) ;;
    *s) echo "${1%s}" ;;
    *) echo $(($1 * 60)) ;;
  esac
}

cmd_write() {
  kind='' to='*' re='' paths='' ttl=''
  while [ $# -gt 0 ]; do
    case $1 in
      -k | --kind) need "$@"; kind=$2; shift 2 ;;
      -t | --to) need "$@"; to=$2; shift 2 ;;
      -r | --re) need "$@"; re=$2; shift 2 ;;
      -p | --paths) need "$@"; paths=$2; shift 2 ;;
      --ttl) need "$@"; ttl=$2; shift 2 ;;
      --) shift; break ;;
      -) break ;;
      -*) die "write: unknown option $1" ;;
      *) break ;;
    esac
  done
  # A message that answers another (-r) is a reply unless -k says otherwise.
  if [ -z "$kind" ]; then
    if [ -n "$re" ]; then kind=reply; else kind=note; fi
  fi
  case " $KINDS " in *" $kind "*) ;; *) die "write: kind must be one of: $KINDS" ;; esac
  if [ $# -eq 0 ] || [ "$*" = - ]; then
    [ -t 0 ] && die "write: no message (pass text or pipe it on stdin)"
    body=$(cat)
  else
    body=$*
  fi
  [ -n "$body" ] || die "write: empty message"
  if [ "$kind" = claim ]; then
    [ -n "$paths" ] || die "write: a claim needs -p PATHS (what you are working on)"
    : "${ttl:=2h}"
  fi
  expires=''
  [ -n "$ttl" ] && expires=$(($(now_epoch) + $(parse_ttl "$ttl")))

  ensure_store
  need_writable
  id=$(stamp)-$SHORT-$(rand)
  {
    printf 'Id: %s\nDate: %s\nAgent: %s\nSession: %s\nBranch: %s\nWorktree: %s\nKind: %s\nTo: %s\n' \
      "$id" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$AGENT" "$SESSION" "$(oneline "$(branch)")" \
      "$(oneline "$(worktree)")" "$kind" "$(oneline "$to")"
    printf 'Host: %s\n' "$(host)"
    [ -n "$re" ] && printf 'Re: %s\n' "$(oneline "$re")"
    [ -n "$paths" ] && printf 'Paths: %s\n' "$(oneline "$paths")"
    [ -n "$expires" ] && printf 'Expires: %s\n' "$expires"
    printf '\n%s\n' "$body"
  } | atomic_write "$W/msgs/$id.msg"
  touch_presence
  printf '%s\n' "$id"

  if [ "$kind" = claim ]; then
    others=$(active_claims | awk -F '\t' -v me="$SESSION" '$4 != me')
    if [ -n "$others" ]; then
      printf 'agentlog: other active claims — check for overlap:\n' >&2
      printf '%s\n' "$others" | fmt_claims >&2
    fi
  fi
}

# Print messages compactly (header line + indented body). File paths on stdin.
fmt_msgs() {
  # shellcheck disable=SC2016
  tr '\n' '\0' | xargs -0 awk -v now="$(now_epoch)" -v brief="${BRIEF:-}" -v here="$(host)" '
    FNR == 1 { inh = 1; id = d = a = s = b = k = t = r = p = e = h = ""; nl = nc = cut = 0 }
    inh && /^$/ {
      line = "[" d "] " a ":" substr(s, 1, 8)
      if (h != "" && h != here) line = line " on " h
      if (b != "" && b != "-") line = line " @" b
      line = line "  " k
      if (t != "" && t != "*") line = line " → " t
      if (r != "") line = line "  re=" r
      if (p != "") line = line "  paths=" p
      if (e != "") line = line "  (" ((e - now > 0) ? int((e - now) / 60) "m left" : "expired") ")"
      print line "  id=" id
      inh = 0; next
    }
    inh {
      key = $0; sub(/:.*/, "", key); val = $0; sub(/^[^:]*: ?/, "", val)
      if (key == "Id") id = val; else if (key == "Date") d = val
      else if (key == "Agent") a = val; else if (key == "Session") s = val
      else if (key == "Branch") b = val; else if (key == "Kind") k = val
      else if (key == "To") t = val; else if (key == "Re") r = val
      else if (key == "Paths") p = val; else if (key == "Expires") e = val
      else if (key == "Host") h = val
      next
    }
    # Brief mode (hook injections): at most 3 body lines / 300 chars.
    brief && cut { next }
    brief && (nl >= 3 || nc + length($0) > 300) {
      if (nc < 300 && nl < 3) print "    " substr($0, 1, 300 - nc) "…"
      print "    … (truncated; agentlog show " id ")"; cut = 1; next
    }
    { nl++; nc += length($0); print "    " $0 }
  '
}

# Print messages as JSON Lines, one object per message. File paths on stdin.
# Missing headers are null; expires is a number. Escaping is done per
# character because backslashes in gsub replacements differ across awks.
fmt_json() {
  # shellcheck disable=SC2016
  tr '\n' '\0' | xargs -0 awk '
    BEGIN {
      for (i = 1; i < 32; i++) esc[sprintf("%c", i)] = sprintf("\\u%04x", i)
      esc["\n"] = "\\n"; esc["\t"] = "\\t"; esc["\r"] = "\\r"
      esc["\""] = "\\\""; esc["\\"] = "\\\\"
    }
    function js(v,   o, c, i) {
      o = ""
      for (i = 1; i <= length(v); i++) { c = substr(v, i, 1); o = o ((c in esc) ? esc[c] : c) }
      return "\"" o "\""
    }
    function opt(v) { return (v == "") ? "null" : js(v) }
    function out() {
      if (!any) return
      printf "{\"id\":%s,\"date\":%s,\"agent\":%s,\"session\":%s,\"host\":%s,\"branch\":%s,\"kind\":%s,\"to\":%s,\"re\":%s,\"paths\":%s,\"expires\":%s,\"body\":%s}\n",
        opt(h["Id"]), opt(h["Date"]), opt(h["Agent"]), opt(h["Session"]), opt(h["Host"]), opt(h["Branch"]),
        opt(h["Kind"]), opt(h["To"]), opt(h["Re"]), opt(h["Paths"]),
        (h["Expires"] ~ /^[0-9]+$/) ? h["Expires"] : "null", js(body)
    }
    FNR == 1 { out(); any = 1; inh = 1; body = ""; nb = 0; split("", h) }
    inh && /^$/ { inh = 0; next }
    inh { key = $0; sub(/:.*/, "", key); val = $0; sub(/^[^:]*: ?/, "", val); h[key] = val; next }
    { body = (nb++ ? body "\n" : "") $0 }
    END { out() }
  '
}

# Delivery is at-least-once: the seen list is merged by rename, so two
# concurrent readers in one session can at worst both show a message.
# A message is for this session if another session sent it to "*", to this
# agent's name, or to a prefix of this session id.
cmd_read() {
  read_from=''
  peek=0 all=0 limit='' fmt=fmt_msgs
  read_kind=''
  while [ $# -gt 0 ]; do
    case $1 in
      --from) need "$@"; [ -n "$2" ] || die "read: --from needs a non-empty value"; read_from=$2; shift 2 ;;
      --peek) peek=1; shift ;;
      --all) all=1; shift ;;
      --json) fmt=fmt_json; shift ;;
      -n) need "$@"; limit=$2; shift 2 ;;
      --kind) need "$@"; read_kind=$2; shift 2 ;;
      *) die "read: unknown option $1" ;;
    esac
  done
  case $limit in *[!0-9]*) die "read: -n needs a non-negative integer" ;; esac
  ensure_store
  work=$TMP/r
  : >"$work.start"
  seen=$work.seen
  cat "$STORE/seen/$SESSION" ${LOCAL:+"$LOCAL/seen/$SESSION"} 2>/dev/null | sort -u >"$seen" || :
  if [ $all -eq 1 ]; then
    index >"$work.new"
    awk -F '\t' -v from="$read_from" '
      from == "" || $3 == from || index($4, from) == 1
    ' "$work.new" >"$work.del"
  else
    index | awk -F '\t' -v seen="$seen" '
      BEGIN { while ((getline l <seen) > 0) s[l] = 1 }
      !($1 in s)' >"$work.new"
    awk -F '\t' -v me="$SESSION" -v agent="$AGENT" -v from="$read_from" '
      $4 != me && ($5 == "*" || $5 == "" || $5 == agent || index(me, $5) == 1) &&
        (from == "" || $3 == from || index($4, from) == 1)
    ' "$work.new" >"$work.del"
  fi
  if [ -n "$read_kind" ]; then
    # Only hide non-matching kinds from output; $work.new still marks all read.
    for k in $(printf '%s' "$read_kind" | tr ',' ' '); do
      case " $KINDS " in *" $k "*) ;; *) die "read: --kind must be from: $KINDS" ;; esac
    done
    awk -F '\t' -v kinds=",$read_kind," 'index(kinds, "," $2 ",")' "$work.del" >"$work.k"
    mv "$work.k" "$work.del"
  fi
  total=$(wc -l <"$work.del" | tr -d ' ')
  if [ -n "$limit" ] && [ "$total" -gt "$limit" ]; then
    # shellcheck disable=SC2016
    notice=$(printf '(%s older unread messages not shown; `agentlog read --all -n %s` to see them)' \
      "$((total - limit))" "$total")
    if [ "$fmt" = fmt_json ]; then printf '%s\n' "$notice" >&2; else printf '%s\n' "$notice"; fi
    tail -n "$limit" "$work.del" >"$work.lim"; mv "$work.lim" "$work.del"
  fi
  [ -s "$work.del" ] && cut -f11 "$work.del" | "$fmt"

  if [ $peek -eq 0 ] && [ -n "$W" ] && [ -s "$work.new" ]; then
    cut -f1 "$work.new" | sort -u "$seen" - | atomic_write "$W/seen/$SESSION"
  fi
  # Cursor mtime = when this read's snapshot began, not when it finished, so
  # the hook's "anything newer?" check cannot skip a message that landed
  # mid-read.
  if [ -n "$W" ]; then
    [ -f "$W/seen/$SESSION" ] || : >"$W/seen/$SESSION"
    touch -r "$work.start" "$W/seen/$SESSION"
  fi
  touch_presence
}

# Observe all senders without changing this session's read cursor. Keep a
# snapshot of ids so following also catches messages published out of order.
cmd_tail() {
  limit=10 follow=0
  while [ $# -gt 0 ]; do
    case $1 in
      -n) need "$@"; limit=$2; shift 2 ;;
      -f) follow=1; shift ;;
      *) die "tail: unknown option $1" ;;
    esac
  done
  case $limit in
    '' | *[!0-9]*) die "tail: -n needs a non-negative integer" ;;
  esac
  ensure_store
  work=$TMP/tail
  trap 'exit 130' INT
  trap 'exit 143' TERM
  index >"$work.index"
  cut -f1 "$work.index" >"$work.ids"
  tail -n "$limit" "$work.index" >"$work.del"
  touch_presence
  while :; do
    if [ -s "$work.del" ]; then
      cut -f11 "$work.del" | fmt_msgs
    fi
    [ "$follow" -eq 1 ] || break
    sleep 2
    index >"$work.index"
    awk -F '\t' -v seen="$work.ids" '
      BEGIN { while ((getline id <seen) > 0) s[id] = 1 }
      !($1 in s)' "$work.index" >"$work.del"
    cut -f1 "$work.index" >"$work.ids"
  done
}

cmd_claims() {
  ensure_store
  active_claims | fmt_claims
}

# Presence records written in the last day, across every store. `who` and the
# dashboard both read sessions through this walk.
session_files() {
  stores | while IFS= read -r st; do
    [ -d "$st/sessions" ] && find "$st/sessions" -type f -mtime -1
  done
}

cmd_who() {
  ensure_store
  session_files | tr '\n' '\0' | xargs -0 awk -F= -v me="$SESSION" -v here="$(host)" '
    FNR == 1 && NR > 1 { out() }
    { v[$1] = substr($0, length($1) + 2) }
    END { if (NR) out() }
    function out() {
      if (v["ended"] == "") {
        mark = (v["session"] == me) ? " (you)" : ""
        if (v["host"] != "" && v["host"] != here) mark = mark " on " v["host"]
        printf "%s\t%s\t  %s  %s:%s%s  @%s  %s\n", v["seen"], v["session"], v["seen"], v["agent"], substr(v["session"], 1, 8), mark, v["branch"], v["worktree"]
      }
      delete v
    }' /dev/null | sort -r | awk -F '\t' '!u[$2]++' | cut -f3-
}

cmd_show() {
  [ $# -eq 1 ] || die "show: need a message id"
  ensure_store
  f=$(index | awk -F '\t' -v id="$1" '$1 == id { print $11 }')
  [ -n "$f" ] || die "show: no message $1"
  cat "$f"
}

cmd_gc() {
  days=7
  [ "${1:-}" = --days ] && { need "$@"; days=$2; }
  case $days in '' | *[!0-9]*) die "gc: --days needs a non-negative integer" ;; esac
  ensure_store
  stores | while IFS= read -r st; do
    is_store "$st" || continue
    # Only ever delete files agentlog names: messages, presence records and
    # its own temp files, never anything else that happens to live there.
    find "$st/msgs" -maxdepth 1 -type f -name '2[0-9]*T*Z-*.msg' -mtime +"$days" -exec rm -f {} + 2>/dev/null || :
    find "$st/sessions" -maxdepth 1 -type f -mtime +"$days" -exec grep -l '^agent=' {} + 2>/dev/null |
      tr '\n' '\0' | xargs -0 rm -f
    [ -d "$st/nudged" ] && find "$st/nudged" -maxdepth 1 -type f -mtime +"$days" -exec rm -f {} + 2>/dev/null
    find "$st/tmp" "$st/msgs" "$st/seen" "$st/sessions" -maxdepth 1 -type f \
      \( -name '.w.*' -o -name '.probe.*' \) -mmin +60 -exec rm -f {} + 2>/dev/null || :
  done
  [ -n "$W" ] || return 0
  index | cut -f1 >"$TMP/ids"
  for f in "$W"/seen/*; do
    [ -f "$f" ] || continue
    sort "$f" | comm -12 - "$TMP/ids" | atomic_write "$f"
  done
}

# ---------------------------------------------------------------- sync
#
# A synced board stays local: hooks read .agentlog/ exactly as before, and a
# background `agentlog sync` copies files both ways with a remote, so no tool
# call ever waits on the network. Messages are immutable and uniquely named,
# so copying in both directions never conflicts. Presence files have one
# writer each; the newer copy wins. Read cursors and nudges stay local.
#
# Remote (`remote=` in ~/.config/agentlog/config, or AGENTLOG_REMOTE):
#   ssh://[user@]host/abs/path   rsync over ssh
#   /abs/path                    a directory (a mount, or tests)
# Each repo syncs to <remote>/<repo key>, the key being its origin URL without
# scheme, user and .git (github.com/owner/repo), so every clone of a repo on
# every machine shares one board.

SYNC_SEC=10

remote_url() { printf '%s' "${AGENTLOG_REMOTE:-$(config_get remote)}"; }

repo_key() {
  _u=$(git config --get remote.origin.url 2>/dev/null) || return 1
  _k=$(printf '%s' "$_u" | sed -e 's|^[A-Za-z+]*://||' -e 's|^[^@/]*@||' \
    -e 's|^\([^/:]*\):[0-9]*/|\1/|' -e 's|^\([^/:]*\):|\1/|' -e 's|\.git/*$||' -e 's|/*$||' |
    tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9._/-')
  case $_k in '' | */* ) ;; *) return 1 ;; esac
  case /$_k/ in */../* | */./* | *//*) return 1 ;; esac
  printf '%s\n' "$_k"
}

# Which repos sync: `sync_repos=` in the config, space-separated globs over
# the repo key (default every repo). Keeps, say, work repos off a home server.
repo_synced() { # repo_synced KEY
  _globs=$(config_get sync_repos)
  set -f
  # shellcheck disable=SC2254 # the patterns are globs on purpose
  for _g in ${_globs:-*}; do case $1 in $_g) set +f; return 0 ;; esac; done
  set +f
  return 1
}

# parse_remote URL: sets RHOST ("" for a directory) and RPATH, or fails.
parse_remote() {
  RHOST='' RPATH=''
  case $1 in
    ssh://*) _r=${1#ssh://}; RHOST=${_r%%/*}; RPATH=/${_r#*/}
      case $_r in */*) ;; *) return 1 ;; esac ;;
    /*) RPATH=$1 ;;
    *) return 1 ;;
  esac
  case $RHOST in -* | *[!A-Za-z0-9._@-]*) return 1 ;; esac
  case $RPATH in *[!A-Za-z0-9._/~-]* | *..*) return 1 ;; esac
  RPATH=${RPATH%/}
}

ssh_opts() {
  printf '%s' '-o BatchMode=yes -o ConnectTimeout=5'
  [ -d "$HOME/.ssh" ] && printf ' -o ControlMaster=auto -o ControlPath=%s/.ssh/agentlog-%%C -o ControlPersist=120' "$HOME"
  return 0
}

cmd_sync() {
  quiet=0
  [ "${1:-}" = --quiet ] && quiet=1
  ensure_store
  if [ -z "$W" ] || [ "$W" != "$STORE" ]; then die "sync: the shared store is not writable here"; fi
  remote=$(remote_url)
  [ -n "$remote" ] || die "sync: no remote (agentlog install --remote ssh://host/path)"
  parse_remote "$remote" || die "sync: unsupported remote '$remote' (ssh://host/abs/path or /abs/path)"
  key=$(repo_key) || die "sync: this repo has no usable origin remote to name its board"
  repo_synced "$key" || die "sync: $key is not in sync_repos ($(config_get sync_repos))"
  command -v rsync >/dev/null 2>&1 || die "sync: needs rsync"
  lock=$STORE/.sync.lock
  if ! mkdir "$lock" 2>/dev/null; then
    # A sync that died mid-way leaves its lock; two minutes is plenty.
    if [ -z "$(find "$lock" -prune -mmin +2 2>/dev/null)" ] || ! { rmdir "$lock" && mkdir "$lock"; } 2>/dev/null; then
      [ $quiet -eq 1 ] && exit 0
      die "sync: another sync is running"
    fi
  fi
  trap 'rm -rf "$TMP"; rmdir "$lock" 2>/dev/null' 0
  dest=$RPATH/$key
  so=$(ssh_opts)
  if [ -n "$RHOST" ]; then
    # shellcheck disable=SC2086,SC2029 # so holds several options; dest is validated
    ssh $so "$RHOST" "mkdir -p '$dest/msgs' '$dest/sessions'" || die "sync: cannot reach $RHOST"
    base=$RHOST:$dest
  else
    mkdir -p "$dest/msgs" "$dest/sessions" || die "sync: cannot create $dest"
    base=$dest
  fi
  rs() { rsync -e "ssh $so" "$@"; }
  v=''; [ $quiet -eq 1 ] || v=-v
  # Messages: copy what the other side lacks. No -t, so a pulled message's
  # mtime is its arrival here, which the hooks' "anything newer?" check needs.
  # Presence keeps its times (staleness reads them) and the newer copy wins.
  if ! { rs -r $v --ignore-existing --include='2*T*Z-*.msg' --exclude='*' "$STORE/msgs/" "$base/msgs/" &&
    rs -r $v --ignore-existing --include='2*T*Z-*.msg' --exclude='*' "$base/msgs/" "$STORE/msgs/" &&
    rs -rt $v --update --exclude='.*' "$STORE/sessions/" "$base/sessions/" &&
    rs -rt $v --update --exclude='.*' "$base/sessions/" "$STORE/sessions/"; }; then
    die "sync: rsync with $base failed"
  fi
  # Once a day, expire old files on the remote the way gc does locally.
  last=$(cat "$STORE/.sync-pruned" 2>/dev/null || echo 0)
  case $last in '' | *[!0-9]*) last=0 ;; esac
  if [ $(($(now_epoch) - last)) -ge 86400 ]; then
    days=$(config_get gc_days); case $days in '' | *[!0-9]*) days=7 ;; esac
    prune="find '$dest/msgs' '$dest/sessions' -type f -mtime +$days -exec rm -f {} +"
    # shellcheck disable=SC2086,SC2029
    if [ -n "$RHOST" ]; then ssh $so "$RHOST" "$prune"; else sh -c "$prune"; fi &&
      now_epoch | atomic_write "$STORE/.sync-pruned"
  fi
  now_epoch | atomic_write "$STORE/.sync-at"
  [ $quiet -eq 1 ] || printf 'synced %s with %s\n' "$STORE" "$base"
}

# Called by every hook: start a background sync when one is due, meaning
# SYNC_SEC have passed or this machine wrote a message since the last one.
maybe_sync() {
  if [ "$W" != "$STORE" ] || [ -z "$(remote_url)" ]; then return 0; fi
  _k=$(repo_key) || return 0
  repo_synced "$_k" || return 0
  last=$(cat "$STORE/.sync-at" 2>/dev/null || echo 0)
  case $last in '' | *[!0-9]*) last=0 ;; esac
  if [ $(($(now_epoch) - last)) -lt "$SYNC_SEC" ] &&
    [ -z "$(find "$STORE/msgs" -maxdepth 1 -name '*.msg' -newer "$STORE/.sync-at" 2>/dev/null | head -1)" ]; then
    return 0
  fi
  [ -d "$STORE/.sync.lock" ] && [ -z "$(find "$STORE/.sync.lock" -prune -mmin +2 2>/dev/null)" ] && return 0
  nohup "$SELF" sync --quiet </dev/null >/dev/null 2>&1 &
}

# ---------------------------------------------------------------- hooks

json_field() { # json_field NAME < json
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg k "$1" '.[$k] // empty' 2>/dev/null
  else
    tr -d '\n' | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p"
  fi
}

json_first() { # json_first NAME < json : first string in the array NAME
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg k "$1" '.[$k][0]? // empty' 2>/dev/null
  else
    tr -d '\n' | sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\[[[:space:]]*\"\([^\"]*\)\".*/\1/p"
  fi
}

json_str() {
  printf '%s' "$1" | tr -d '\000-\010\013\014\016-\037' |
    sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e "s/$(printf '\t')/\\\\t/g" -e "s/$(printf '\r')//g" |
    awk 'BEGIN { ORS = ""; print "\"" } NR > 1 { print "\\n" } { print } END { print "\"" }'
}

# Files a PostToolUse payload says the tool edited, one per line, relative to
# the repo root. Covers Claude/Muse style tool_input fields (file_path,
# notebook_path, path) and apply_patch text (Codex), wherever it sits.
# Read-only tools are skipped so reading a claimed file stays silent.
edited_paths() { # edited_paths JSON
  case $(printf '%s' "$1" | json_field tool_name) in
    *[Rr]ead* | *[Gg]rep* | *[Gg]lob* | LS | *[Ss]earch* | *[Ll]ist* | *[Vv]iew* | *[Ff]etch*) return 0 ;;
  esac
  if command -v jq >/dev/null 2>&1; then
    ti=$(printf '%s' "$1" | jq -c '.tool_input // empty' 2>/dev/null) || ti=''
  else
    # No jq: drop everything from tool_response on, which echoes file contents.
    ti=$(printf '%s' "$1" | tr -d '\n' | awk '{ i = index($0, "\"tool_response\""); if (i) $0 = substr($0, 1, i - 1); print }')
  fi
  [ -n "$ti" ] || return 0
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  prefix=$(git rev-parse --show-prefix 2>/dev/null) || prefix=''
  lroot=$(pwd) && [ -n "$prefix" ] && lroot=${lroot%/"${prefix%/}"}
  printf '%s\n' "$ti" | awk '
    function emit(p) { gsub(/^[ \t]+|[ \t]+$/, "", p); gsub(/\/\/+/, "/", p); if (p != "") print p }
    {
      s = $0
      while (match(s, /"(file_path|notebook_path|path)"[ \t]*:[ \t]*"[^"]*"/)) {
        m = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        sub(/^"[a-z_]*"[ \t]*:[ \t]*"/, "", m); sub(/"$/, "", m); emit(m)
      }
      s = $0
      while (match(s, /\*\*\* (Update File|Add File|Delete File|Move to): [^"\\]*/)) {
        m = substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH)
        sub(/^[^:]*: /, "", m); emit(m)
      }
    }' | while IFS= read -r p; do
    case $p in
      /*)
        # git reports the physical root (/private/var on macOS); match it.
        _d=$(cd "${p%/*}/" 2>/dev/null && pwd -P) && p=$_d/${p##*/}
        case $p in
          "$root"/*) printf '%s\n' "${p#"$root"/}" ;;
          "$lroot"/*) printf '%s\n' "${p#"$lroot"/}" ;;
        esac ;;
      *) printf '%s%s\n' "$prefix" "${p#./}" ;;
    esac
  done | sort -u
}

# Does FILE fall under claim path PAT? PAT is a file, a directory (with or
# without a trailing /) or a glob where * also crosses /. Agents sometimes
# add ":symbol" to a path; the part before the colon counts too.
path_in_claim() { # path_in_claim FILE PAT
  for _p in "$2" "${2%%:*}"; do
    _p=${_p#./}
    [ -n "$_p" ] || continue
    case $1 in "$_p" | "${_p%/}"/*) return 0 ;; esac
    # shellcheck disable=SC2254 # the claim path is a glob on purpose
    case $_p in *[*?[]*) case $1 in $_p) return 0 ;; esac ;; esac
  done
  return 1
}

# Warning text for edits to FILES (newline-separated) that fall inside other
# sessions' active claims. Each claim warns a session once (nudged/<session>).
claim_warnings() { # claim_warnings FILES
  claims=$(active_claims | awk -F '\t' -v me="$SESSION" '$4 != me')
  [ -n "$claims" ] || return 0
  nudged=$W/nudged/$SESSION
  tab=$(printf '\t')
  hits=$(set -f; printf '%s\n' "$claims" | cut -f1,8 | while IFS=$tab read -r id cpaths; do
    grep -qsx "$id" "$nudged" && continue
    for pat in $(printf '%s' "$cpaths" | tr ',' ' '); do
      hit=$(printf '%s\n' "$1" | while IFS= read -r f; do
        if path_in_claim "$f" "$pat"; then printf '%s\n' "$f"; break; fi
      done)
      if [ -n "$hit" ]; then printf '%s\t%s\n' "$id" "$hit"; break; fi
    done
  done)
  [ -n "$hits" ] || return 0
  mkdir -p "$W/nudged" 2>/dev/null || :
  printf '%s\n' "$hits" | cut -f1 >>"$nudged" 2>/dev/null || :
  printf '%s\n' "agentlog: you just edited files inside another session's active claim. Check with its owner before going further (write -k request -t <session> ...), or leave the files alone."
  printf '%s\n' "$hits" | while IFS=$tab read -r id f; do
    printf '%s\n' "$claims" | awk -F '\t' -v id="$id" '$1 == id' | fmt_claims
    printf '    you edited: %s\n' "$f"
  done
}

# ---------------------------------------------------------------- install

self_path() { printf '%s\n' "$SELF"; }
install_dest() { printf '%s/agentlog\n' "${AGENTLOG_PREFIX:-$HOME/.local/bin}"; }
codex_rules() { printf '%s/rules/agentlog.rules\n' "${CODEX_HOME:-$HOME/.codex}"; }

# Codex execpolicy: commands whose every segment matches an allow rule run
# outside the sandbox. Allow only the installed copy (outside any workspace,
# so a sandboxed agent cannot edit it) and only board subcommands — never
# install, gc, tail -f or hook.
codex_rule_text() {
  cat <<EOF
# Installed by \`agentlog install\` (agentlog $VERSION). Lets Codex run the
# installed agentlog outside its sandbox, so agents in linked worktrees can
# write to the shared board. Remove with \`agentlog install --uninstall\`.
prefix_rule(
    pattern = ["$1", ["write", "w", "read", "r", "claims", "who", "show", "whoami", "dir"]],
    decision = "allow",
    justification = "agentlog: shared message board for agents working in the same repo",
)
EOF
}

# Antigravity CLI permission grants: `command(<prefix>)` entries under
# permissions.allow in its settings.json skip the approval prompt, which
# headless runs otherwise auto-deny. Same subcommands as the Codex rule. Not
# a sandbox bypass. Merged with jq so the rest of the file is untouched;
# skipped without jq, or when the file does not parse.
# Where Antigravity keeps permission grants: the CLI's settings file, and the
# shared config that Antigravity 2.0 migrated everything into (edited only if
# it already exists). FILE<TAB>JSON path of the allow list.
agy_targets() {
  printf '%s/.gemini/antigravity-cli/settings.json\t["permissions","allow"]\n' "$HOME"
  printf '%s/.gemini/config/config.json\t["userSettings","globalPermissionGrants","allow"]\n' "$HOME"
}
agy_grants() { # agy_grants DEST -> JSON array of command(...) grants
  printf '['; _sep=''
  for _s in write w read r claims who show whoami dir; do
    printf '%s"command(%s %s)"' "$_sep" "$1" "$_s"; _sep=,
  done
  printf ']\n'
}
agy_edit() { # agy_edit add|remove DEST
  command -v jq >/dev/null 2>&1 || return 0
  tab=$(printf '\t')
  agy_targets | while IFS=$tab read -r _f _path; do
    [ -d "$(dirname "$_f")" ] || continue
    case $_f in */config/config.json) [ -f "$_f" ] || continue ;; esac
    [ -f "$_f" ] || [ "$1" = add ] || continue
    _in=$(cat "$_f" 2>/dev/null || :)
    [ -n "$_in" ] || _in='{}'
    if [ "$1" = add ]; then
      _p='(getpath($p) // []) as $a | setpath($p; $a + ($g - $a))'
    else
      _p='if (getpath($p) | type) == "array" then setpath($p; getpath($p) - $g) else . end'
    fi
    _out=$(printf '%s' "$_in" | jq --argjson g "$(agy_grants "$2")" --argjson p "$_path" "$_p" 2>/dev/null) || continue
    if [ "$(printf '%s' "$_in" | jq -c . 2>/dev/null)" = "$(printf '%s' "$_out" | jq -c .)" ]; then
      say "up to date: $_f"
      continue
    fi
    (umask 077 && printf '%s\n' "$_out" >"$_f.tmp.$$") && mv -f "$_f.tmp.$$" "$_f"
    if [ "$1" = add ]; then say "antigravity grants: $_f (Antigravity runs $2 board commands without asking)"; else say "removed agentlog grants from $_f"; fi
  done
}

# Copies this script to $AGENTLOG_PREFIX (~/.local/bin) and, when Codex or
# Antigravity is present, installs their allow rules. Idempotent; hooks run
# it on SessionStart.
#
# Choices made by hand stick: `--no-codex-rule` and `--uninstall` are recorded
# in ~/.config/agentlog/config, and the hooks' `--auto` install obeys them.
# Running `agentlog install` (or `--codex-rule`) by hand opts back in.
config_file() { printf '%s/.config/agentlog/config\n' "$HOME"; }
config_get() { sed -n "s/^$1=//p" "$(config_file)" 2>/dev/null | tail -1; }
config_set() {
  _c=$(config_file)
  mkdir -p "$(dirname "$_c")"
  { grep -v "^$1=" "$_c" 2>/dev/null || :; printf '%s=%s\n' "$1" "$2"; } >"$_c.tmp.$$"
  mv -f "$_c.tmp.$$" "$_c"
}

cmd_install() {
  quiet=0 rule='' arule='' uninstall=0 auto=0
  while [ $# -gt 0 ]; do
    case $1 in
      --quiet) quiet=1; shift ;;
      --auto) auto=1; quiet=1; shift ;;
      --codex-rule) rule=yes; shift ;;
      --no-codex-rule) rule=no; shift ;;
      --antigravity-rule) arule=yes; shift ;;
      --no-antigravity-rule) arule=no; shift ;;
      --uninstall) uninstall=1; shift ;;
      --remote) need "$@"; parse_remote "$2" || die "install: unsupported remote '$2' (ssh://host/abs/path or /abs/path)"
        config_set remote "$2"; printf 'remote: %s (each repo syncs to %s/<repo key>)\n' "$2" "$2"; shift 2 ;;
      --no-remote) config_set remote ''; printf 'remote: off (boards stay on this machine)\n'; shift ;;
      --sync-repos) need "$@"; config_set sync_repos "$2"; printf 'sync_repos: %s\n' "${2:-*}"; shift 2 ;;
      *) die "install: unknown option $1" ;;
    esac
  done
  dest=$(install_dest) rules=$(codex_rules) self=$(self_path)
  say() { [ $quiet -eq 1 ] || printf '%s\n' "$*"; }
  rm_rule() {
    if [ -f "$rules" ] && grep -q 'Installed by `agentlog install`' "$rules"; then rm -f "$rules"; say "removed $rules"; fi
  }

  if [ $uninstall -eq 1 ]; then
    if [ -f "$dest" ] && grep -q '^# agentlog — a shared' "$dest"; then rm -f "$dest"; say "removed $dest"; fi
    rm_rule
    agy_edit remove "$dest"
    config_set install no
    say "auto-install disabled (run \`agentlog install\` to re-enable)"
    return 0
  fi
  if [ $auto -eq 1 ]; then
    [ "$(config_get install)" != no ] || return 0
    rule=$(config_get codex_rule) arule=$(config_get antigravity_rule)
  else
    [ "$(config_get install)" != no ] || config_set install yes
    [ -n "$rule" ] && config_set codex_rule "$rule"
    [ -n "$arule" ] && config_set antigravity_rule "$arule"
  fi
  : "${rule:=yes}" "${arule:=yes}"

  if [ "$self" != "$dest" ] && ! { [ -f "$dest" ] && [ ! -L "$dest" ] && cmp -s "$self" "$dest"; }; then
    mkdir -p "$(dirname "$dest")"
    _t=$(dirname "$dest")/.agentlog.$$
    cp "$self" "$_t" && chmod 755 "$_t" && mv -f "$_t" "$dest"
    say "installed $dest (agentlog $VERSION)"
  else
    say "up to date: $dest"
  fi

  if [ "$rule" = no ]; then
    rm_rule
  elif [ -d "$(dirname "$(dirname "$rules")")" ]; then
    text=$(codex_rule_text "$dest")
    if [ "$(cat "$rules" 2>/dev/null)" != "$text" ]; then
      mkdir -p "$(dirname "$rules")"
      printf '%s\n' "$text" >"$rules.tmp.$$" && mv -f "$rules.tmp.$$" "$rules"
      say "codex rule: $rules (new Codex sessions run $dest outside the sandbox)"
    else
      say "up to date: $rules"
    fi
  fi

  if [ "$arule" = no ]; then agy_edit remove "$dest"; else agy_edit add "$dest"; fi
}

# ---------------------------------------------------------------- hooks

# Hook entry point for Claude Code, Codex and Muse (Claude's hooks.json
# contract) on SessionStart, UserPromptSubmit and PostToolUse, and for
# Antigravity on SessionStart and PreInvocation.
#  - Silent unless there is something to say, and silent outside git repos.
#  - SessionStart only introduces agentlog when the repo is actually shared:
#    another session was active in the last 2h, or there are claims/unread.
#  - The per-tool-call path exits after a cheap mtime check when nothing is
#    newer than this session's read cursor.
#
# hook AGENT [EVENT]: Claude Code, Codex and Muse send Claude-style JSON
# (session_id, hook_event_name, cwd) and read hookSpecificOutput back.
# Antigravity sends conversationId and workspacePaths, runs hooks from the
# plugin directory, names no event (hence EVENT), and reads injectSteps.
cmd_hook() {
  input=$(cat)
  agent=${1:-} event=${2:-}
  sid=$(printf '%s' "$input" | json_field session_id)
  [ -n "$sid" ] || sid=$(printf '%s' "$input" | json_field conversationId)
  [ -n "$event" ] || event=$(printf '%s' "$input" | json_field hook_event_name)
  dir=$(printf '%s' "$input" | json_field cwd)
  [ -n "$dir" ] || dir=$(printf '%s' "$input" | json_first workspacePaths)
  if [ "$agent" = muse ] && [ -n "${MUSE_SESSION_ID:-}" ]; then
    # Muse also runs hooks for its internal side threads (reminder checks,
    # subagents), each with its own session_id. Only the main thread, whose
    # thread id is the session id, takes part; the rest would consume
    # messages the main thread never sees.
    [ "${MUSE_THREAD_ID:-$MUSE_SESSION_ID}" = "$MUSE_SESSION_ID" ] || exit 0
    sid=$MUSE_SESSION_ID
  fi
  # Antigravity runs PreInvocation before every model call; treat it like a
  # prompt submission (presence, then the cheap "anything new?" check).
  # Antigravity 2.0 has no SessionStart, so a conversation's first
  # PreInvocation (no presence record yet) stands in for it below.
  first_call=''
  [ "$event" = PreInvocation ] && event=UserPromptSubmit first_call=1
  if [ -n "$dir" ] && [ -d "$dir" ]; then cd "$dir" || exit 0; fi
  [ -n "$sid" ] && AGENTLOG_SESSION=$sid
  [ -n "$agent" ] && AGENTLOG_AGENT=$agent
  export AGENTLOG_SESSION AGENTLOG_AGENT
  if [ -z "${AGENTLOG_DIR:-}" ] && ! git rev-parse --git-dir >/dev/null 2>&1; then exit 0; fi
  detect_identity

  ensure_store
  if [ -n "$first_call" ] && [ ! -f "$STORE/sessions/$SESSION" ] &&
    { [ -z "$LOCAL" ] || [ ! -f "$LOCAL/sessions/$SESSION" ]; }; then
    event=SessionStart
  fi
  if [ "$event" = SessionStart ] && [ -z "${AGENTLOG_NO_INSTALL:-}" ]; then
    (cmd_install --auto) >/dev/null 2>&1 || :
  fi
  [ -n "$W" ] || exit 0

  HOOKED=1
  [ "$event" = SessionEnd ] || maybe_sync
  case $event in
    SessionStart | UserPromptSubmit) touch_presence ;;
    SessionEnd)
      # Release whatever this session still holds and drop its presence.
      if active_claims | awk -F '\t' -v me="$SESSION" '$4 == me { f = 1 } END { exit !f }'; then
        cmd_write -k release "session ended" >/dev/null 2>&1 || :
      fi
      # Mark the presence ended rather than delete it: a synced copy on
      # another machine would only bring it back.
      ENDED=1 touch_presence
      [ -n "$LOCAL" ] && [ "$W" != "$LOCAL" ] && rm -f "$LOCAL/sessions/$SESSION" 2>/dev/null
      maybe_sync
      exit 0
      ;;
    *)
      # Tool calls keep presence fresh too, at most every few minutes.
      [ -n "$(find "$W/sessions/$SESSION" -mmin -5 2>/dev/null)" ] || touch_presence
      ;;
  esac
  warn=''
  if [ "$event" = PostToolUse ]; then
    files=$(edited_paths "$input")
    [ -n "$files" ] && warn=$(claim_warnings "$files")
  fi
  if [ "$event" != SessionStart ] && [ -z "$warn" ]; then
    cursor=$W/seen/$SESSION
    [ -f "$STORE/seen/$SESSION" ] && cursor=$STORE/seen/$SESSION
    if [ -f "$cursor" ]; then
      fresh=$(stores | while IFS= read -r st; do
        find "$st/msgs" -maxdepth 1 -name '*.msg' -newer "$cursor" 2>/dev/null | head -1
      done | head -1)
      [ -n "$fresh" ] || exit 0
    fi
  fi

  unread=$(BRIEF=1; cmd_read -n 10)
  al=$(self_path)
  if [ -x "$(install_dest)" ] && cmp -s "$al" "$(install_dest)"; then al=$(install_dest); fi
  ctx=''
  case $event in
    SessionStart)
      claims=$(cmd_claims)
      others=$(stores | while IFS= read -r st; do
        find "$st/sessions" -maxdepth 1 -type f -mmin -120 ! -name "$SESSION" -exec grep -L '^ended=' {} + 2>/dev/null
      done | head -1)
      [ -n "$others$claims$unread" ] || exit 0
      ctx="agentlog: other agents are working in this repo. You are $AGENT:$SHORT (session $SESSION).
Use the agentlog skill. Command: $al (e.g. \`$al write -k claim -p 'src/foo/**' \"refactoring foo\"\`). Claim before larger edits; when finished, post \`done -r <claim-id>\`; reply to requests addressed to you."
      [ -n "$claims" ] && ctx="$ctx

Active claims:
$claims"
      [ -n "$unread" ] && ctx="$ctx

Unread messages:
$unread"
      ;;
    *)
      ctx=$warn
      [ -n "$unread" ] && ctx="${ctx:+$ctx

}agentlog: new messages from other agents in this repo (you are $AGENT:$SHORT; command: $al). Act on requests addressed to you; reply with \`$al write -k reply -r <id> ...\`.
$unread"
      ;;
  esac
  [ -n "$ctx" ] || exit 0
  if [ "$agent" = antigravity ]; then
    printf '{"injectSteps":[{"ephemeralMessage":%s}]}\n' "$(json_str "$ctx")"
  else
    printf '{"hookSpecificOutput":{"hookEventName":%s,"additionalContext":%s}}\n' \
      "$(json_str "${event:-UserPromptSubmit}")" "$(json_str "$ctx")"
  fi
}

# ---------------------------------------------------------------- dashboard
#
# `dashboard` serves a live page of the board on 127.0.0.1. The shell side
# gathers the data with the functions the other commands use and writes one
# event per line; the Perl program below (core modules only, embedded so that
# `install`, which copies this one file, carries it) only serves it. It is
# read-only: no presence, no read cursors.

json_array() { awk 'BEGIN { printf "[" } NR > 1 { printf "," } { printf "%s", $0 } END { print "]" }'; }

# Sessions as TSV, newest first, one line per session:
#   seen session agent branch worktree stale(1|0)
# Same walk as `who`; ended sessions are skipped. A session is stale when it is
# hooked (via=hook) and was last seen more than STALE_MIN minutes ago.
sessions_tsv() {
  session_files | while IFS= read -r f; do
    stale=0
    if grep -qsx 'via=hook' "$f" && [ -n "$(find "$f" -prune -mmin +"$STALE_MIN")" ]; then stale=1; fi
    awk -F= -v stale="$stale" '
      { v[$1] = substr($0, length($1) + 2) }
      END {
        if (v["ended"] == "" && v["session"] != "")
          printf "%s\t%s\t%s\t%s\t%s\t%s\n", v["seen"], v["session"], v["agent"], v["branch"], v["worktree"], stale
      }' "$f"
  done | sort -r | awk -F '\t' '!u[$2]++'
}

# The same sessions as a JSON array, escaped per character like fmt_json.
sessions_json() {
  sessions_tsv | awk -F '\t' '
    BEGIN {
      for (i = 1; i < 32; i++) esc[sprintf("%c", i)] = sprintf("\\u%04x", i)
      esc["\n"] = "\\n"; esc["\t"] = "\\t"; esc["\r"] = "\\r"; esc["\""] = "\\\""; esc["\\"] = "\\\\"
      printf "["
    }
    function js(v,   o, c, i) {
      o = ""
      for (i = 1; i <= length(v); i++) { c = substr(v, i, 1); o = o ((c in esc) ? esc[c] : c) }
      return "\"" o "\""
    }
    {
      printf "%s{\"agent\":%s,\"session\":%s,\"branch\":%s,\"worktree\":%s,\"seen\":%s,\"stale\":%s}",
        (NR > 1 ? "," : ""), js($3), js($2), js($4), js($5), js($1), ($6 == 1 ? "true" : "false")
    }
    END { print "]" }'
}

# The event feed for dashboard_pl, one event per line:
#   store "PATH"          once, the store path shown on the page
#   msg {json}            a message, oldest first; the last LIMIT at start, then new ones
#   claims [...]          active claims, when they change
#   sessions [...]        sessions, when they change
#   tick                  every poll: ignored by the server, but a write to a server
#                         that has exited fails, so the feed stops (see below)
# The loop also ends when its parent shell is gone. Without that check a feed
# whose server died and whose shell was killed would keep polling forever.
dashboard_feed() { # dashboard_feed LIMIT OWNER_PID
  _lim=$1 _owner=$2 _w=$TMP/feed first=1
  : >"$_w.claims"; : >"$_w.sessions"; : >"$_w.ids"
  printf 'store '; json_str "$STORE"; printf '\n'
  while kill -0 "$_owner" 2>/dev/null; do
    index >"$_w.idx"
    if [ $first -eq 1 ]; then
      tail -n "$_lim" "$_w.idx" | cut -f11 | fmt_json | sed 's/^/msg /'
      first=0
    else
      awk -F '\t' -v seen="$_w.ids" '
        BEGIN { while ((getline id <seen) > 0) s[id] = 1 }
        !($1 in s)' "$_w.idx" | cut -f11 | fmt_json | sed 's/^/msg /'
    fi
    cut -f1 "$_w.idx" >"$_w.ids"
    active_claims | cut -f11 | fmt_json | json_array >"$_w.cn"
    cmp -s "$_w.cn" "$_w.claims" || { printf 'claims '; cat "$_w.cn"; mv -f "$_w.cn" "$_w.claims"; }
    sessions_json >"$_w.sn"
    cmp -s "$_w.sn" "$_w.sessions" || { printf 'sessions '; cat "$_w.sn"; mv -f "$_w.sn" "$_w.sessions"; }
    printf 'tick\n'
    sleep 2
  done
}

cmd_dashboard() {
  port=4747 limit=1000 open_browser=1
  while [ $# -gt 0 ]; do
    case $1 in
      --port) need "$@"; port=$2; shift 2 ;;
      -n) need "$@"; limit=$2; shift 2 ;;
      --no-open) open_browser=0; shift ;;
      *) die "dashboard: unknown option $1" ;;
    esac
  done
  case $port in '' | *[!0-9]*) die "dashboard: --port needs an integer from 0 to 65535" ;; esac
  [ "$port" -le 65535 ] || die "dashboard: --port needs an integer from 0 to 65535"
  case $limit in '' | *[!0-9]*) die "dashboard: -n needs a positive integer" ;; esac
  [ "$limit" -gt 0 ] || die "dashboard: -n needs a positive integer"
  command -v perl >/dev/null 2>&1 || die "dashboard needs perl"
  # The page opens in the default browser only from a terminal, and not with
  # --no-open. Perl runs the opener once the server is listening; no opener
  # (empty) means nothing is opened.
  opener=''
  if [ $open_browser -eq 1 ] && [ -t 1 ]; then
    if [ "$(uname -s)" = Darwin ]; then opener=$(command -v open 2>/dev/null) || :
    else opener=$(command -v xdg-open 2>/dev/null) || :; fi
  fi
  ensure_store
  DASHBOARD_PL=$(dashboard_pl)
  # The server is a direct background job, so $! is its own pid, and the feed
  # writes into a FIFO. The traps kill both at once, so the port is free as
  # soon as this shell gets INT or TERM. Background jobs ignore SIGINT in a
  # non-interactive shell, which is why the trap, not the terminal, stops perl.
  fifo=$TMP/feed.fifo
  mkfifo "$fifo"
  perl -e "$DASHBOARD_PL" -- "$port" "$limit" "$opener" <"$fifo" &
  pid=$!
  dashboard_feed "$limit" "$$" >"$fifo" &
  fpid=$!
  trap 'kill "$pid" "$fpid" 2>/dev/null; exit 130' INT
  trap 'kill "$pid" "$fpid" 2>/dev/null; exit 143' TERM
  status=0
  wait "$pid" || status=$?
  kill "$fpid" 2>/dev/null || :
  exit "$status"
}

# The server. Single-threaded select loop over stdin (the feed), the listening
# socket and the clients. Routes: / (page), /app.js, /events (SSE). GET only,
# Host must be localhost or 127.0.0.1 (DNS rebinding), no CORS.
dashboard_pl() {
  cat <<'PERL'
use strict;
use warnings;
use Errno qw(EAGAIN EINTR);
use IO::Socket::INET;
use IO::Select;
use POSIX ();

my ($want_port, $cap, $opener) = @ARGV;
$opener = '' unless defined $opener;
$want_port = 0 unless defined $want_port && $want_port =~ /^\d+$/;
$cap = 1000 unless defined $cap && $cap =~ /^\d+$/ && $cap > 0;
$| = 1;
$SIG{PIPE} = 'IGNORE';
$SIG{CHLD} = 'IGNORE';   # reap the opener without a zombie

my ($PAGE, $APP_JS);  # set below, before the loop
my $CSP = "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'";
my $MAX_OUT = 1024 * 1024;
my %REASON = (200 => 'OK', 400 => 'Bad Request', 403 => 'Forbidden', 404 => 'Not Found', 405 => 'Method Not Allowed');
my %clients;          # fileno => { sock, in, out, sse, closing }
my @ring;             # { id, json } for the last $cap messages
my $store = '""';     # JSON string of the store path
my $claims = '[]';
my $sessions = '[]';
my $in_buf = '';
my $last_ping = time;

my $listen = IO::Socket::INET->new(
    LocalAddr => '127.0.0.1',
    LocalPort => $want_port,
    Proto     => 'tcp',
    Listen    => 16,
    ReuseAddr => 1,
) or die "agentlog: dashboard: cannot listen on 127.0.0.1:$want_port: $!\n";
my $port = $listen->sockport;
print "agentlog: dashboard at http://127.0.0.1:$port/ (Ctrl-C to stop)\n";
if ($opener ne '') {
    my $url = "http://127.0.0.1:$port/";
    my $pid = fork();
    if (defined $pid && $pid == 0) {
        open STDIN,  '<', '/dev/null';
        open STDOUT, '>', '/dev/null';
        open STDERR, '>', '/dev/null';
        exec { $opener } $opener, $url or POSIX::_exit(127);
    }
}

sub sse_msg {
    my ($e) = @_;
    return (defined $e->{id} ? "id: $e->{id}\n" : '') . "event: msg\ndata: $e->{json}\n\n";
}

sub broadcast_sse {
    my ($text) = @_;
    for my $c (values %clients) {
        next unless $c->{sse};
        $c->{out} .= $text;
        drop($c) if length $c->{out} > $MAX_OUT;
    }
}

sub feed_line {
    my ($line) = @_;
    if ($line =~ /\Amsg (\{.*\})\z/) {
        my $json = $1;
        my $id;
        $id = $1 if $json =~ /\A\{"id":"((?:[^"\\]|\\.)*)"/;
        push @ring, { id => $id, json => $json };
        shift @ring while @ring > $cap;
        broadcast_sse(sse_msg($ring[-1]));
    }
    elsif ($line =~ /\Astore (".*")\z/) { $store = $1 }
    elsif ($line =~ /\Aclaims (\[.*\])\z/) {
        $claims = $1;
        broadcast_sse("event: claims\ndata: $claims\n\n");
    }
    elsif ($line =~ /\Asessions (\[.*\])\z/) {
        $sessions = $1;
        broadcast_sse("event: sessions\ndata: $sessions\n\n");
    }
    # tick, and anything unknown: ignored
}

sub read_stdin {
    my $n = sysread(STDIN, my $buf, 65536);
    return if !defined $n && ($! == EAGAIN || $! == EINTR);
    exit 0 if !$n;    # the feed ended, or failed: nothing left to serve
    $in_buf .= $buf;
    while ((my $nl = index($in_buf, "\n")) >= 0) {
        my $line = substr($in_buf, 0, $nl + 1, '');
        chomp $line;
        feed_line($line);
    }
}

sub drop {
    my ($c) = @_;
    my $fd = fileno($c->{sock});
    return unless defined $fd && delete $clients{$fd};
    close($c->{sock});
}

sub respond {
    my ($c, $code, $type, $body, $extra) = @_;
    $c->{out} .= "HTTP/1.1 $code $REASON{$code}\r\n"
        . "Content-Type: $type\r\n"
        . "Content-Length: " . length($body) . "\r\n"
        . "Cache-Control: no-store\r\n"
        . "Content-Security-Policy: $CSP\r\n"
        . "X-Content-Type-Options: nosniff\r\n"
        . "Connection: close\r\n"
        . ($extra // '') . "\r\n"
        . $body;
    $c->{closing} = 1;
}

sub start_sse {
    my ($c, $last_id, $query) = @_;
    my $n = $cap;
    $n = $1 if $query =~ /(?:\A|&)n=(\d+)/;
    $n = 1 if $n < 1;
    $n = $cap if $n > $cap;
    my $start;
    if (defined $last_id && length $last_id) {
        for my $i (reverse 0 .. $#ring) {
            if (defined $ring[$i]{id} && $ring[$i]{id} eq $last_id) { $start = $i + 1; last }
        }
    }
    my $from = defined $start ? $start : (@ring - $n < 0 ? 0 : @ring - $n);
    $c->{sse} = 1;
    $c->{out} .= "HTTP/1.1 200 OK\r\n"
        . "Content-Type: text/event-stream\r\n"
        . "Cache-Control: no-cache\r\n"
        . "Content-Security-Policy: $CSP\r\n"
        . "X-Content-Type-Options: nosniff\r\n"
        . "Connection: keep-alive\r\n\r\n";
    $c->{out} .= "event: store\ndata: $store\n\n"
        . "event: claims\ndata: $claims\n\n"
        . "event: sessions\ndata: $sessions\n\n";
    $c->{out} .= sse_msg($_) for @ring[$from .. $#ring];
}

sub handle_request {
    my ($c) = @_;
    my ($head) = $c->{in} =~ /\A(.*?)\r?\n\r?\n/s;
    my @lines = split /\r?\n/, $head;
    my ($method, $target) = split ' ', (shift(@lines) // '');
    my %h;
    for (@lines) { $h{lc $1} = $2 if /^([^:\s]+):\s*(.*?)\s*$/ }
    $method //= '';
    $target //= '';
    my $host = $h{host} // '';
    return respond($c, 403, 'text/plain; charset=utf-8', "forbidden\n")
        unless $host eq "127.0.0.1:$port" || $host eq "localhost:$port";
    return respond($c, 405, 'text/plain; charset=utf-8', "method not allowed\n", "Allow: GET\r\n")
        unless $method eq 'GET';
    my ($path, $query) = ($target =~ /\A([^?]*)(?:\?(.*))?\z/s);
    $query //= '';
    if ($path eq '/') { respond($c, 200, 'text/html; charset=utf-8', $PAGE) }
    elsif ($path eq '/app.js') { respond($c, 200, 'text/javascript; charset=utf-8', $APP_JS) }
    elsif ($path eq '/events') { start_sse($c, $h{'last-event-id'}, $query) }
    else { respond($c, 404, 'text/plain; charset=utf-8', "not found\n") }
}

sub read_client {
    my ($c) = @_;
    my $n = sysread($c->{sock}, my $buf, 4096);
    if (!defined $n) { return if $! == EAGAIN || $! == EINTR; return drop($c) }
    return drop($c) if $n == 0;
    return if $c->{sse} || $c->{closing};    # SSE clients send nothing we use
    $c->{in} .= $buf;
    if ($c->{in} =~ /\r?\n\r?\n/) { handle_request($c) }
    elsif (length $c->{in} > 8192) { respond($c, 400, 'text/plain; charset=utf-8', "bad request\n") }
}

sub flush_client {
    my ($c) = @_;
    return unless length $c->{out};
    my $n = syswrite($c->{sock}, $c->{out});
    if (!defined $n) { return if $! == EAGAIN || $! == EINTR; return drop($c) }
    substr($c->{out}, 0, $n, '');
}

sub accept_client {
    my $s = $listen->accept or return;
    $s->blocking(0);
    $clients{fileno($s)} = { sock => $s, in => '', out => '', sse => 0, closing => 0 };
}

# The page and its script. ASCII only: Content-Length counts characters.
$PAGE = <<'HTML';
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>agentlog</title>
<style>
:root {
  --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
  --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  --muted: #7d849c; --second: #a9afc6; --title: #8b92ab; --text: #eef0f7;
  --panel: rgba(15, 20, 38, .92); --line: rgba(255, 255, 255, .12); --row: rgba(255, 255, 255, .06);
  --coral: #ff7a59;
}
html { background-color: #0b1020; }
body {
  margin: 0; padding: 16px; min-height: 100vh; box-sizing: border-box; color: var(--text);
  font-family: var(--sans); font-size: 15px; line-height: 1.45;
  background-color: #0b1020;
  background-image:
    radial-gradient(ellipse 45% 45% at 85% 85%, rgba(255, 122, 89, .22), rgba(255, 122, 89, 0)),
    radial-gradient(ellipse 50% 50% at 20% 25%, rgba(124, 92, 255, .35), rgba(124, 92, 255, 0)),
    radial-gradient(rgba(255, 255, 255, .06) 1.2px, transparent 1.3px),
    linear-gradient(135deg, #0b1020 0%, #151036 55%, #22103a 100%);
